[Unit]
Description=relayfsd - monitors a dir and syncs files via SFTP
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=/usr/bin/relayfsd
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
